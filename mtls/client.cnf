[ req ]
default_bits       = 2048
default_md         = sha256
prompt             = no
encrypt_key        = no

distinguished_name = req_distinguished_name
req_extensions     = req_ext

[ req_distinguished_name ]
C  = US
ST = Washington
L  = Seattle
O  = Widgets, Inc.
OU = Engineering
CN = spice-client

[ req_ext ]
extendedKeyUsage = clientAuth
